# ============================================================
# OpenClaw Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Required ---

# Anthropic API key (get one at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Telegram bot token (create a bot via @BotFather on Telegram)
# Format: <numeric-id>:<alphanumeric-token>
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklmnoPQRstuvWXYZ1234567890

# --- Optional ---

# Docker image to use (default: latest pre-built image from GitHub)
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# Timezone for the container (default: UTC)
# Examples: America/New_York, Europe/London, Asia/Tokyo
OPENCLAW_TZ=UTC

# Gateway authentication token (leave empty to disable auth)
OPENCLAW_GATEWAY_TOKEN=
